import type { FastifyPluginAsync } from 'fastify'
import { randomBytes } from 'node:crypto'
import { existsSync, readFileSync } from 'node:fs'
import { dirname, join, parse } from 'node:path'
import { fileURLToPath } from 'node:url'
import { z } from 'zod'
import { createChannelAccountsRepository } from '@docmee/db'
import { encryptValue } from '@docmee/shared'
import { withDb } from '../lib/db.js'
import { validate } from '../lib/validate.js'
import { resolveClinicScope } from '../lib/scope.js'
import { requireAuth, requireRole } from '../middleware/auth.js'

const whatsappSchema = z.object({
  provider: z.enum(['meta_whatsapp', 'twilio_whatsapp', 'evolution_test']).optional(),
  accountId: z.string().min(1),
  displayName: z.string().optional(),
  accessToken: z.string().min(1).optional(),
  webhookVerifyToken: z.string().optional(),
  status: z.enum(['active', 'inactive', 'error']).optional(),
  tokenExpiresAt: z.string().optional(),
  twilioMessagingServiceSid: z.string().optional(),
  twilioWhatsappFrom: z.string().optional(),
  evolutionInstance: z.string().optional(),
}).superRefine((data, ctx) => {
  if (data.provider !== 'twilio_whatsapp') return
  if (!data.twilioMessagingServiceSid?.trim() && !data.twilioWhatsappFrom?.trim()) {
    ctx.addIssue({
      code: z.ZodIssueCode.custom,
      message: 'Set either a Twilio Messaging Service SID or a Twilio WhatsApp sender number.',
      path: ['twilioMessagingServiceSid'],
    })
  }
})

const embeddedSignupSchema = z.object({
  code: z.string().min(1),
  phoneNumberId: z.string().min(1),
  wabaId: z.string().min(1).optional(),
  displayName: z.string().optional(),
  webhookVerifyToken: z.string().optional(),
})

const twilioSenderSchema = z.object({
  accountSid: z.string().min(1),
  authToken: z.string().min(1),
  senderId: z.string().min(1),
  wabaId: z.string().optional(),
  profileName: z.string().optional(),
})

const GRAPH_API_VERSION = process.env['META_GRAPH_API_VERSION'] || 'v24.0'

function metaEmbeddedSignupConfig() {
  const appId = process.env['META_APP_ID'] || process.env['NEXT_PUBLIC_META_APP_ID'] || ''
  const configId =
    process.env['META_EMBEDDED_SIGNUP_CONFIG_ID'] ||
    process.env['META_LOGIN_CONFIG_ID'] ||
    process.env['NEXT_PUBLIC_META_EMBEDDED_SIGNUP_CONFIG_ID'] ||
    ''
  return {
    appId,
    configId,
    graphApiVersion: GRAPH_API_VERSION,
    isConfigured: Boolean(appId && configId && process.env['META_APP_SECRET']),
    missing: [
      !appId ? 'META_APP_ID' : null,
      !configId ? 'META_EMBEDDED_SIGNUP_CONFIG_ID' : null,
      !process.env['META_APP_SECRET'] ? 'META_APP_SECRET' : null,
    ].filter(Boolean),
  }
}

async function exchangeEmbeddedSignupCode(code: string): Promise<string> {
  const { appId } = metaEmbeddedSignupConfig()
  const appSecret = process.env['META_APP_SECRET'] ?? ''
  if (!appId || !appSecret) throw new Error('Meta app credentials are not configured')

  const url = new URL(`https://graph.facebook.com/${GRAPH_API_VERSION}/oauth/access_token`)
  url.searchParams.set('client_id', appId)
  url.searchParams.set('client_secret', appSecret)
  url.searchParams.set('code', code)

  const res = await fetch(url)
  const body = (await res.json().catch(() => null)) as { access_token?: string; error?: { message?: string } } | null
  if (!res.ok || !body?.access_token) {
    throw new Error(body?.error?.message ?? `Meta token exchange failed with ${res.status}`)
  }
  return body.access_token
}

async function graphRequest<T>(
  path: string,
  accessToken: string,
  init: RequestInit = {},
): Promise<{ ok: true; data: T } | { ok: false; error: string }> {
  const url = new URL(`https://graph.facebook.com/${GRAPH_API_VERSION}/${path.replace(/^\//, '')}`)
  const headers = new Headers(init.headers)
  headers.set('Authorization', `Bearer ${accessToken}`)
  const res = await fetch(url, { ...init, headers })
  const data = (await res.json().catch(() => null)) as (T & { error?: { message?: string } }) | null
  if (!res.ok) return { ok: false, error: data?.error?.message ?? `Graph API request failed with ${res.status}` }
  return { ok: true, data: data as T }
}

async function subscribeWabaToApp(wabaId: string | undefined, accessToken: string): Promise<{ subscribed: boolean; error?: string }> {
  if (!wabaId) return { subscribed: false, error: 'Embedded Signup did not return a WABA ID.' }
  const result = await graphRequest<{ success?: boolean }>(`${wabaId}/subscribed_apps`, accessToken, { method: 'POST' })
  if (!result.ok) return { subscribed: false, error: result.error }
  return { subscribed: true }
}

function publicWebhookUrl(path: string) {
  const appUrl = (process.env['APP_URL'] || process.env['PUBLIC_APP_URL'] || process.env['WEBHOOK_BASE_URL'] || '').replace(/\/$/, '')
  return `${appUrl || 'https://docmeedevelopment.dev'}/api${path}`
}

function normalizeTwilioSenderId(senderId: string) {
  const trimmed = senderId.trim()
  return trimmed.startsWith('whatsapp:') ? trimmed : `whatsapp:${trimmed}`
}

function optionalTrimmed(value: string | undefined) {
  const trimmed = value?.trim() ?? ''
  return trimmed || ''
}

function readEncryptionKeyFromLocalEnv(startDir: string) {
  let currentDir = startDir
  const root = parse(currentDir).root
  while (true) {
    const envPath = join(currentDir, '.env')
    if (existsSync(envPath)) {
      const line = readFileSync(envPath, 'utf8')
        .split(/\r?\n/)
        .find((item) => item.trim().startsWith('ENCRYPTION_KEY='))
      const separatorIndex = line?.indexOf('=') ?? -1
      const value = separatorIndex >= 0 ? line?.slice(separatorIndex + 1).trim() : ''
      if (value) return value.replace(/^['"]|['"]$/g, '')
    }
    const keyPath = join(currentDir, 'ENCRYPTION_KEY.txt')
    if (existsSync(keyPath)) {
      const value = readFileSync(keyPath, 'utf8').trim()
      if (value) return value.replace(/^['"]|['"]$/g, '')
    }
    if (currentDir === root) return ''
    currentDir = dirname(currentDir)
  }
}

function resolveEncryptionKey() {
  const existing = process.env['ENCRYPTION_KEY']?.trim()
  if (existing) return existing
  const local =
    readEncryptionKeyFromLocalEnv(process.cwd()) ||
    readEncryptionKeyFromLocalEnv(dirname(fileURLToPath(import.meta.url)))
  if (local) process.env['ENCRYPTION_KEY'] = local
  return local
}

function encryptChannelSecret(value: string) {
  if (!resolveEncryptionKey()) {
    throw new Error(
      'ENCRYPTION_KEY is not set. Set ENCRYPTION_KEY to a stable secret before saving WhatsApp or Twilio tokens.',
    )
  }
  return encryptValue(value)
}

function isEncryptionConfigError(error: unknown) {
  return error instanceof Error && error.message.includes('ENCRYPTION_KEY')
}

function hasStoredTwilioMessagingServiceSid(settings: Record<string, unknown>) {
  return Boolean(
    (typeof settings?.twilioMessagingServiceSidEnc === 'string' && settings.twilioMessagingServiceSidEnc) ||
      (typeof settings?.twilioMessagingServiceSid === 'string' && settings.twilioMessagingServiceSid),
  )
}

function buildTwilioMessagingServiceSettings(value: string | undefined, existingSettings: Record<string, unknown>) {
  const trimmed = optionalTrimmed(value)
  if (trimmed === '****') {
    const existingPlaintext =
      typeof existingSettings.twilioMessagingServiceSid === 'string' ? existingSettings.twilioMessagingServiceSid : ''
    const existingEncrypted =
      typeof existingSettings.twilioMessagingServiceSidEnc === 'string' ? existingSettings.twilioMessagingServiceSidEnc : ''
    return {
      twilioMessagingServiceSid: '',
      twilioMessagingServiceSidEnc: existingEncrypted || (existingPlaintext ? encryptChannelSecret(existingPlaintext) : ''),
    }
  }
  if (!trimmed) {
    return {
      twilioMessagingServiceSid: '',
      twilioMessagingServiceSidEnc: '',
    }
  }
  return {
    twilioMessagingServiceSid: '',
    twilioMessagingServiceSidEnc: encryptChannelSecret(trimmed),
  }
}

async function createTwilioWhatsAppSender({
  accountSid,
  authToken,
  senderId,
  wabaId,
  profileName,
}: {
  accountSid: string
  authToken: string
  senderId: string
  wabaId?: string
  profileName?: string
}) {
  const callbackUrl = publicWebhookUrl('/webhook/whatsapp/twilio')
  const body = {
    senderId: normalizeTwilioSenderId(senderId),
    configuration: {
      ...(wabaId ? { wabaId } : {}),
      callbackUrl,
      callbackMethod: 'POST',
      fallbackUrl: callbackUrl,
      fallbackMethod: 'POST',
      statusCallbackUrl: publicWebhookUrl('/webhook/whatsapp/twilio/status'),
      ...(profileName ? { profile: { name: profileName } } : {}),
    },
  }
  const response = await fetch('https://messaging.twilio.com/v2/Channels/Senders', {
    method: 'POST',
    headers: {
      authorization: `Basic ${Buffer.from(`${accountSid}:${authToken}`).toString('base64')}`,
      'content-type': 'application/json',
    },
    body: JSON.stringify(body),
  })
  const data = (await response.json().catch(() => null)) as
    | { sid?: string; sender_id?: string; senderId?: string; status?: string; message?: string; code?: number }
    | null
  if (!response.ok || !data?.sid) {
    throw new Error(data?.message ?? `Twilio sender registration failed with ${response.status}`)
  }
  return {
    sid: data.sid,
    senderId: data.sender_id ?? data.senderId ?? body.senderId,
    status: data.status ?? 'creating',
    callbackUrl,
    statusCallbackUrl: publicWebhookUrl('/webhook/whatsapp/twilio/status'),
  }
}

async function fetchPhoneNumberInfo(phoneNumberId: string, accessToken: string) {
  const result = await graphRequest<{
    id?: string
    display_phone_number?: string
    verified_name?: string
    quality_rating?: string
    code_verification_status?: string
    name_status?: string
  }>(
    `${phoneNumberId}?fields=display_phone_number,verified_name,quality_rating,code_verification_status,name_status`,
    accessToken,
  )
  if (!result.ok) return { phoneInfo: null, phoneInfoError: result.error }
  return { phoneInfo: result.data, phoneInfoError: undefined }
}

function redactAccount(account: {
  id: string
  clinicId: string
  channel: string
  accountId: string
  displayName: string | null
  status: string
  accessTokenEnc: string | null
  webhookVerifyToken: string | null
  settings: Record<string, unknown>
  createdAt: string
  updatedAt: string
}) {
  return {
    id: account.id,
    clinicId: account.clinicId,
    channel: account.channel,
    accountId: account.accountId,
    displayName: account.displayName,
    status: account.status,
    provider:
      account.settings?.provider === 'twilio_whatsapp' ||
      account.settings?.provider === 'meta_whatsapp' ||
      account.settings?.provider === 'evolution_test'
        ? account.settings.provider
        : 'meta_whatsapp',
    hasAccessToken: Boolean(account.accessTokenEnc),
    hasWebhookVerifyToken: Boolean(account.webhookVerifyToken),
    tokenExpiresAt:
      typeof account.settings?.tokenExpiresAt === 'string' ? account.settings.tokenExpiresAt : null,
    twilioMessagingServiceSid: hasStoredTwilioMessagingServiceSid(account.settings) ? '****' : null,
    twilioWhatsappFrom:
      typeof account.settings?.twilioWhatsappFrom === 'string' ? account.settings.twilioWhatsappFrom : null,
    twilioSenderSid:
      typeof account.settings?.twilioSenderSid === 'string' ? account.settings.twilioSenderSid : null,
    twilioSenderId:
      typeof account.settings?.twilioSenderId === 'string' ? account.settings.twilioSenderId : null,
    twilioSenderStatus:
      typeof account.settings?.twilioSenderStatus === 'string' ? account.settings.twilioSenderStatus : null,
    evolutionInstance:
      typeof account.settings?.evolutionInstance === 'string' ? account.settings.evolutionInstance : null,
    evolutionApiUrl:
      typeof account.settings?.evolutionApiUrl === 'string' ? account.settings.evolutionApiUrl : null,
    createdAt: account.createdAt,
    updatedAt: account.updatedAt,
  }
}

const channelsRoute: FastifyPluginAsync = async (app) => {
  app.addHook('preHandler', requireAuth)

  app.get(
    '/channels/meta-config',
    { preHandler: requireRole('clinic_admin', 'ia_studio_admin') },
    async () => {
      const config = metaEmbeddedSignupConfig()
      return {
        appId: config.appId || null,
        configId: config.configId || null,
        graphApiVersion: config.graphApiVersion,
        isConfigured: config.isConfigured,
        missing: config.missing,
      }
    },
  )

  app.get<{ Params: { id: string } }>(
    '/clinics/:id/channels',
    { preHandler: requireRole('clinic_admin', 'ia_studio_admin') },
    async (request, reply) => {
      const clinicId = resolveClinicScope(request, request.params.id)
      if (!clinicId) return reply.code(403).send({ error: 'Forbidden' })
      const accounts = await withDb(async (sql) => createChannelAccountsRepository(sql).listByClinic(clinicId))
      return { accounts: accounts.map(redactAccount) }
    },
  )

  app.put<{ Params: { id: string; channel: string } }>(
    '/clinics/:id/channels/:channel',
    { preHandler: requireRole('clinic_admin', 'ia_studio_admin') },
    async (request, reply) => {
      if (request.params.channel !== 'whatsapp') {
        return reply.code(400).send({ error: 'Only WhatsApp channel linking is supported here' })
      }
      const parsed = validate(whatsappSchema, request.body, reply)
      if (!parsed.ok) return
      const clinicId = resolveClinicScope(request, request.params.id)
      if (!clinicId) return reply.code(403).send({ error: 'Forbidden' })

      try {
        const account = await withDb(async (sql) => {
          const repo = createChannelAccountsRepository(sql)
          const provider = parsed.data.provider ?? 'meta_whatsapp'
          const existing = (await repo.listByClinic(clinicId)).find(
            (item) => item.channel === 'whatsapp' && item.accountId === parsed.data.accountId,
          )
          const settings = {
            ...(existing?.settings ?? {}),
            provider,
            ...(parsed.data.tokenExpiresAt ? { tokenExpiresAt: parsed.data.tokenExpiresAt } : {}),
            ...(provider === 'twilio_whatsapp'
              ? {
                  ...buildTwilioMessagingServiceSettings(parsed.data.twilioMessagingServiceSid, existing?.settings ?? {}),
                  twilioWhatsappFrom: parsed.data.twilioWhatsappFrom?.trim()
                    ? normalizeTwilioSenderId(parsed.data.twilioWhatsappFrom)
                    : '',
                }
              : {}),
            ...(provider === 'evolution_test'
              ? {
                  evolutionInstance: parsed.data.evolutionInstance?.trim() || process.env['EVOLUTION_INSTANCE'] || 'docmee2',
                  evolutionApiUrl: process.env['EVOLUTION_API_URL'] || 'http://127.0.0.1:8080',
                  testMode: true,
                }
              : {}),
          }
          return repo.create({
            clinicId,
            channel: 'whatsapp',
            accountId: parsed.data.accountId,
            displayName: parsed.data.displayName ?? existing?.displayName ?? undefined,
            accessTokenEnc: parsed.data.accessToken
              ? encryptChannelSecret(parsed.data.accessToken)
              : existing?.accessTokenEnc ?? undefined,
            webhookVerifyToken: parsed.data.webhookVerifyToken ?? existing?.webhookVerifyToken ?? undefined,
            status: parsed.data.status ?? existing?.status ?? 'active',
            settings,
          })
        })

        return { account: redactAccount(account) }
      } catch (error) {
        if (isEncryptionConfigError(error)) return reply.code(500).send({ error: (error as Error).message })
        throw error
      }
    },
  )

  app.post<{ Params: { id: string } }>(
    '/clinics/:id/channels/whatsapp/embedded-signup',
    { preHandler: requireRole('clinic_admin', 'ia_studio_admin') },
    async (request, reply) => {
      const parsed = validate(embeddedSignupSchema, request.body, reply)
      if (!parsed.ok) return
      const clinicId = resolveClinicScope(request, request.params.id)
      if (!clinicId) return reply.code(403).send({ error: 'Forbidden' })

      try {
        const accessToken = await exchangeEmbeddedSignupCode(parsed.data.code)
        const subscription = await subscribeWabaToApp(parsed.data.wabaId, accessToken)
        const phoneLookup = await fetchPhoneNumberInfo(parsed.data.phoneNumberId, accessToken)
        const account = await withDb(async (sql) => {
          const repo = createChannelAccountsRepository(sql)
          const existing = (await repo.listByClinic(clinicId)).find(
            (item) => item.channel === 'whatsapp' && item.accountId === parsed.data.phoneNumberId,
          )
          const webhookVerifyToken =
            parsed.data.webhookVerifyToken?.trim() ||
            existing?.webhookVerifyToken ||
            `docmee_${randomBytes(18).toString('hex')}`
          return repo.create({
            clinicId,
            channel: 'whatsapp',
            accountId: parsed.data.phoneNumberId,
            displayName:
              parsed.data.displayName ??
              phoneLookup.phoneInfo?.verified_name ??
              phoneLookup.phoneInfo?.display_phone_number ??
              existing?.displayName ??
              'WhatsApp Business',
            accessTokenEnc: encryptChannelSecret(accessToken),
            webhookVerifyToken,
            status: 'active',
            settings: {
              ...(existing?.settings ?? {}),
              source: 'embedded_signup',
              wabaId: parsed.data.wabaId,
              embeddedSignupVersion: 'standard',
              appSubscribedToWaba: subscription.subscribed,
              appSubscriptionError: subscription.error,
              phoneInfo: phoneLookup.phoneInfo,
              phoneInfoError: phoneLookup.phoneInfoError,
              linkedAt: new Date().toISOString(),
            },
          })
        })
        return { account: redactAccount(account) }
      } catch (error) {
        request.log.error({ err: error }, 'Meta Embedded Signup completion failed')
        if (isEncryptionConfigError(error)) return reply.code(500).send({ error: (error as Error).message })
        return reply.code(400).send({ error: (error as Error).message })
      }
    },
  )

  app.post<{ Params: { id: string } }>(
    '/clinics/:id/channels/whatsapp/twilio-sender',
    { preHandler: requireRole('clinic_admin', 'ia_studio_admin') },
    async (request, reply) => {
      const parsed = validate(twilioSenderSchema, request.body, reply)
      if (!parsed.ok) return
      const clinicId = resolveClinicScope(request, request.params.id)
      if (!clinicId) return reply.code(403).send({ error: 'Forbidden' })

      try {
        const sender = await createTwilioWhatsAppSender(parsed.data)
        const account = await withDb(async (sql) => {
          const repo = createChannelAccountsRepository(sql)
          const existing = (await repo.listByClinic(clinicId)).find(
            (item) => item.channel === 'whatsapp' && item.accountId === parsed.data.accountSid,
          )
          return repo.create({
            clinicId,
            channel: 'whatsapp',
            accountId: parsed.data.accountSid,
            displayName: parsed.data.profileName ?? existing?.displayName ?? 'Twilio WhatsApp',
            accessTokenEnc: encryptChannelSecret(parsed.data.authToken),
            webhookVerifyToken: existing?.webhookVerifyToken ?? undefined,
            status: 'active',
            settings: {
              ...(existing?.settings ?? {}),
              provider: 'twilio_whatsapp',
              twilioSenderSid: sender.sid,
              twilioSenderId: sender.senderId,
              twilioSenderStatus: sender.status,
              twilioWabaId: parsed.data.wabaId ?? '',
              twilioCallbackUrl: sender.callbackUrl,
              twilioStatusCallbackUrl: sender.statusCallbackUrl,
            },
          })
        })
        return { account: redactAccount(account), sender }
      } catch (error) {
        request.log.error({ err: error }, 'Twilio WhatsApp sender registration failed')
        if (isEncryptionConfigError(error)) return reply.code(500).send({ error: (error as Error).message })
        return reply.code(400).send({ error: (error as Error).message })
      }
    },
  )
}

export default channelsRoute
