function LaunchWaiverEditor({
  waiver,
  onSave,
}: {
  waiver?: LaunchWaiver
  onSave: (waiver: LaunchWaiver | null) => void
}) {
  const [open, setOpen] = useState(false)
  const [reviewer, setReviewer] = useState(waiver?.reviewer ?? '')
  const [reason, setReason] = useState(waiver?.reason ?? '')
  const [risk, setRisk] = useState(waiver?.risk ?? '')
  const [owner, setOwner] = useState(waiver?.owner ?? '')
  const [followUpDate, setFollowUpDate] = useState(waiver?.followUpDate ?? '')
  const ready = Boolean(reviewer.trim() && reason.trim() && risk.trim() && owner.trim() && followUpDate)

  if (waiver && !open) {
    return (
      <div className="mt-2 rounded-md border border-amber-200 bg-amber-50 p-2 text-xs text-amber-800 dark:border-amber-900 dark:bg-amber-950/30 dark:text-amber-100">
        <div className="flex flex-wrap items-center justify-between gap-2">
