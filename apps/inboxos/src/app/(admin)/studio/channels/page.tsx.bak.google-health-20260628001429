            disabled={!ready}
            onClick={() => {
              onSave({
                reviewer: reviewer.trim(),
                reason: reason.trim(),
                risk: risk.trim(),
                owner: owner.trim(),
                followUpDate,
                createdAt: new Date().toISOString(),
              })
              setOpen(false)
            }}
            className="rounded-md bg-amber-600 px-3 py-1.5 text-xs font-medium text-white disabled:opacity-60"
