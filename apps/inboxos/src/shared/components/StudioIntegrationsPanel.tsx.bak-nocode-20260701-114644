  const [replyTo, setReplyTo] = useState(config.replyTo ?? '')
  const [smtpHost, setSmtpHost] = useState(config.smtpHost ?? initialDefaults.host)
  const [smtpPort, setSmtpPort] = useState(String(config.smtpPort ?? initialDefaults.port))
  const [smtpSecure, setSmtpSecure] = useState(Boolean(config.smtpSecure ?? initialDefaults.secure))
