          </p>
          <div className="flex gap-2">
            <button type="button" onClick={() => setOpen(true)} className="font-medium underline">
              Edit
            </button>
            <button type="button" onClick={() => onSave(null)} className="font-medium underline">
              Clear
            </button>
          </div>
        </div>
        <p className="mt-1">Risk: {waiver.risk}. Owner: {waiver.owner}.</p>
      </div>
    )
  }

  return (
    <div className="mt-2 rounded-md border border-gray-200 bg-white p-2 dark:border-gray-800 dark:bg-gray-900">
      <button
        type="button"
        onClick={() => setOpen((value) => !value)}
        className="text-xs font-medium text-amber-700 hover:underline dark:text-amber-300"
      >
        {open ? 'Hide waiver' : waiver ? 'Edit waiver' : 'Record waiver'}
      </button>
      {open ? (
        <div className="mt-2 grid gap-2 sm:grid-cols-2">
          <input value={reviewer} onChange={(e) => setReviewer(e.target.value)} placeholder="Reviewer" className="rounded-md border border-gray-300 px-2 py-1.5 text-xs dark:border-gray-700 dark:bg-gray-950" />
