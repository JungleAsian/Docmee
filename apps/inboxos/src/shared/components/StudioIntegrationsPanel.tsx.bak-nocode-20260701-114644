    queryKey: ['ai-status', clinic.id],
    queryFn: () => api.get<{ providers: AiProviderStatus[] }>(`/clinic/${clinic.id}/ai/status`),
  })
  const statusFor = (provider: AiProvider) =>
    aiStatus.data?.providers.find((p) => p.provider === provider) ?? null
