'use client'

// Screen 10 — Channels & integrations. Pick a clinic, then see an at-a-glance health
// card for every channel/integration: connection state, concrete setup gaps, the
// webhook URL, and Meta token-expiry warnings (Req 19). Each card links into the
// matching section of the clinic detail page to fix things. WhatsApp is shown as an
// informational card because its config lives outside the clinic record.
import { useEffect, useMemo, useState } from 'react'
import { useMutation, useQuery, useQueryClient } from '@tanstack/react-query'
import { api, API_BASE } from '@/shared/api/client'
import { ClinicSelect } from '@/shared/components/ClinicSelect'
import { useI18n } from '@/shared/hooks/useI18n'
import { useActiveClinic } from '@/shared/hooks/useActiveClinic'
import {
  channelCards,
  type ServiceCard,
  type ServiceKey,
  type ServiceStatus,
} from '@/shared/channelStatus'
import type { TranslationKey } from '@/shared/i18n'
import type { Clinic, ClinicSettings } from '@/shared/types'

interface ChannelAccount {
  id: string
  clinicId: string
  channel: 'whatsapp' | 'messenger' | 'instagram'
  accountId: string
  displayName: string | null
  status: 'active' | 'inactive' | 'error'
  provider?: 'meta_whatsapp' | 'twilio_whatsapp' | 'evolution_test'
  hasAccessToken: boolean
  hasWebhookVerifyToken: boolean
  tokenExpiresAt: string | null
  twilioMessagingServiceSid?: string | null
  twilioWhatsappFrom?: string | null
  twilioSenderSid?: string | null
  twilioSenderId?: string | null
  twilioSenderStatus?: string | null
  evolutionInstance?: string | null
  evolutionApiUrl?: string | null
  createdAt: string
  updatedAt: string
}

interface MetaEmbeddedSignupConfig {
  appId: string | null
  configId: string | null
  graphApiVersion: string
  isConfigured: boolean
  missing: string[]
}

interface WhatsAppHealthCheck {
  key: string
  label: string
  state: 'pass' | 'warning' | 'fail'
  detail: string
  action: string
}

interface WhatsAppHealthResponse {
  checkedAt: string
  overall: 'ready' | 'test_mode' | 'blocked'
  productionReady: boolean
  providerSummary: {
    metaConfigured: boolean
    missingMetaConfig: string[]
    activeProductionAccounts: number
    activeMetaAccounts: number
    activeTwilioAccounts: number
    activeEvolutionTestAccounts: number
  }
  checks: WhatsAppHealthCheck[]
  requiredActions: string[]
}

interface EmbeddedSignupAssets {
  event?: 'FINISH' | 'CANCEL' | 'ERROR'
  phoneNumberId?: string
  wabaId?: string
  errorMessage?: string
}

interface ProviderReadiness {
  key: 'meta' | 'google' | 'email' | 'openai' | 'anthropic'
  label?: string
  state: 'ready' | 'missing' | 'fallback'
  configured: boolean
  required?: boolean
  severity?: 'required' | 'recommended'
  missing: string[]
  action?: string
}

interface ProviderStatusResponse {
  checkedAt?: string
  overall?: 'ready' | 'needs_llm' | 'missing_required'
  summary?: {
    requiredMissing: string[]
    llmReady: boolean
    missingVars: string[]
  }
  providers: ProviderReadiness[]
}

interface LaunchWaiver {
  reviewer: string
  reason: string
  risk: string
  owner: string
  followUpDate: string
  createdAt: string
}

interface LaunchReadinessEvent {
  id: string
  actorEmail: string | null
  action: string
  field: string
  createdAt: string
}

declare global {
  interface Window {
    FB?: {
      init: (options: { appId: string; autoLogAppEvents?: boolean; xfbml?: boolean; version: string }) => void
      login: (
        callback: (response: { authResponse?: { code?: string } }) => void,
        options: Record<string, unknown>,
      ) => void
    }
    fbAsyncInit?: () => void
  }
}

