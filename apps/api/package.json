{
  "name": "@docmee/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/apps/api/src/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1077.0",
    "@aws-sdk/s3-request-presigner": "^3.1077.0",
    "@docmee/agents": "workspace:*",
    "@docmee/channels": "workspace:*",
    "@docmee/db": "workspace:*",
    "@docmee/llm": "workspace:*",
    "@docmee/notifications": "workspace:*",
    "@docmee/queue": "workspace:*",
    "@docmee/shared": "workspace:*",
    "@fastify/multipart": "^8.3.1",
    "@fastify/sensible": "^5.5.0",
    "dotenv": "^16.4.5",
    "fast-jwt": "^6.2.4",
    "fastify": "^4.28.0",
    "ioredis": "5.10.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "tsx": "^4.15.7",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
