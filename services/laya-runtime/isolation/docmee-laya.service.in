[Unit]
Description=Isolated offline LAYA boundary (loaded is not qualified)
Requires=docmee-laya.socket
After=docmee-laya.socket
StartLimitIntervalSec=300s
StartLimitBurst=3

[Service]
Type=exec
ExecStart=@RELEASE@/venv/bin/python -I -B @RELEASE@/isolation/entrypoint.py
WorkingDirectory=/
DynamicUser=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateNetwork=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=@RELEASE@
InaccessiblePaths=-/opt/docmee -/etc/docmee -/var/lib/docmee -/var/www -/srv -/home -/root -/run/credentials -/etc/credstore -/etc/ssh -/etc/ssl/private -/var/lib/cloud -/run/dbus -/run/systemd/private -/run/docker.sock -/var/run/docker.sock -/etc/resolv.conf -/run/systemd/resolve
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
RemoveIPC=yes
RestrictAddressFamilies=AF_INET
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~connect @mount io_uring_setup io_uring_enter io_uring_register
SystemCallErrorNumber=EPERM
UMask=0077
Environment=OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1
UnsetEnvironment=PYTHONPATH PYTHONHOME PYTHONSTARTUP LD_PRELOAD LD_LIBRARY_PATH HF_TOKEN HUGGING_FACE_HUB_TOKEN AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_SESSION_TOKEN
CPUQuota=100%
MemoryHigh=2500M
MemoryMax=3G
MemorySwapMax=0
TasksMax=16
LimitNOFILE=64
LimitCORE=0
StandardInput=null
StandardOutput=null
StandardError=null
TimeoutStartSec=60s
TimeoutStopSec=5s
RuntimeMaxSec=1d
Restart=on-failure
RestartSec=5s
KillMode=control-group
SendSIGKILL=yes
