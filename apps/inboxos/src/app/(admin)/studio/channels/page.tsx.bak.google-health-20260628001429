              <label className="block">
                <span className="mb-1 block font-medium text-gray-500 dark:text-gray-400">
                  Twilio WhatsApp sender number {hasTwilioMessagingService ? '(optional)' : '(or use Messaging Service above)'}
                </span>
                <input
                  value={twilioWhatsappFrom}
                  onChange={(event) => setTwilioWhatsappFrom(event.target.value)}
                  className="w-full rounded-md border border-gray-300 bg-white px-2 py-1.5 text-sm dark:border-gray-700 dark:bg-gray-950"
                  placeholder="whatsapp:+14155238886"
                />
                <span className="mt-1 block text-[11px] text-gray-400">
                  Use a Twilio-approved WhatsApp Business sender; Docmee will add the whatsapp: prefix if omitted.
                </span>
              </label>
              <div className="rounded-lg border border-sky-200 bg-sky-50 p-3 dark:border-sky-900 dark:bg-sky-950/30">
                <h3 className="text-sm font-semibold text-sky-900 dark:text-sky-100">Register a WhatsApp sender</h3>
                <p className="mt-1 text-[11px] text-sky-800 dark:text-sky-200">
                  Use this when the clinic completed Twilio Embedded Signup and you have the WABA ID plus phone number.
                  WABA ID is required for the first sender on a subaccount; additional senders can usually omit it.
                </p>
                <div className="mt-2 grid gap-2 sm:grid-cols-2">
                  <label className="block">
                    <span className="mb-1 block font-medium text-sky-900 dark:text-sky-100">WABA ID</span>
                    <input
                      value={twilioWabaId}
                      onChange={(event) => setTwilioWabaId(event.target.value)}
                      className="w-full rounded-md border border-sky-200 bg-white px-2 py-1.5 text-sm dark:border-sky-900 dark:bg-gray-950"
                      placeholder="123456789012345"
                    />
                  </label>
                  <label className="block">
                    <span className="mb-1 block font-medium text-sky-900 dark:text-sky-100">Sender phone</span>
                    <input
                      value={twilioSenderPhone}
                      onChange={(event) => setTwilioSenderPhone(event.target.value)}
                      className="w-full rounded-md border border-sky-200 bg-white px-2 py-1.5 text-sm dark:border-sky-900 dark:bg-gray-950"
                      placeholder="+50255550001"
                    />
                  </label>
                </div>
                <div className="mt-2 rounded-md border border-sky-200 bg-white/70 p-2 text-[11px] text-sky-800 dark:border-sky-900 dark:bg-gray-950/40 dark:text-sky-200">
                  Docmee sends Twilio: sender_id, optional waba_id, callback_url, fallback_url, status_callback_url,
                  and profile.name when provided.
                </div>
                <button
                  type="button"
                  onClick={() => {
                    setMessage(null)
                    twilioSenderMutation.mutate()
                  }}
                  disabled={
                    twilioSenderMutation.isPending ||
                    !twilioAccountSid.trim() ||
                    !twilioAuthToken.trim() ||
                    !twilioSenderPhone.trim()
                  }
                  className="mt-2 rounded-md bg-sky-700 px-3 py-1.5 text-xs font-medium text-white disabled:opacity-60"
                >
                  {twilioSenderMutation.isPending ? 'Registering...' : 'Register sender with Twilio'}
                </button>
              </div>
              <label className="block">
                <span className="mb-1 block font-medium text-gray-500 dark:text-gray-400">Display name</span>
                <input
                  value={displayName}
                  onChange={(event) => setDisplayName(event.target.value)}
                  className="w-full rounded-md border border-gray-300 bg-white px-2 py-1.5 text-sm dark:border-gray-700 dark:bg-gray-950"
                  placeholder="Twilio WhatsApp"
                />
              </label>
            </div>

            <div className="rounded-lg border border-sky-200 bg-sky-50 p-3 text-sky-900 dark:border-sky-900 dark:bg-sky-950/30 dark:text-sky-100">
              <h3 className="text-sm font-semibold">Twilio setup checklist</h3>
              <ol className="mt-2 list-decimal space-y-1 pl-4 text-[11px]">
                <li>Onboard or verify the clinic WhatsApp Business sender in Twilio.</li>
                <li>Paste this webhook URL into Twilio's inbound message callback.</li>
                <li>Use the Account SID and Auth Token from the Twilio Console.</li>
                <li>Set either a Messaging Service SID or the Twilio-approved WhatsApp sender number.</li>
                <li>Send a sandbox or live WhatsApp test after saving.</li>
              </ol>
              <div className="mt-3 rounded-md border border-sky-200 bg-white/70 p-2 text-[11px] dark:border-sky-900 dark:bg-gray-950/40">
                Messaging Service SIDs are encrypted and masked as **** after saving. A WhatsApp sender can replace the Messaging Service SID when the sender is hosted in this Twilio account.
              </div>
            </div>
          </div>

          <div className="mt-3 flex items-center justify-between gap-2 border-t border-gray-100 pt-2 dark:border-gray-800">
            <button
              type="button"
              onClick={() => setStep('start')}
              className="rounded-md border border-gray-300 px-3 py-1.5 text-xs dark:border-gray-700"
            >
              Back
            </button>
            <p className={twilioMutation.isError ? 'text-xs text-red-500' : 'text-xs text-emerald-500'}>{message}</p>
            <button
              type="button"
              onClick={() => {
                setMessage(null)
                twilioMutation.mutate()
              }}
              disabled={twilioMutation.isPending || !canSaveTwilio}
              className="shrink-0 rounded-md bg-sky-600 px-3 py-1.5 text-xs font-medium text-white disabled:opacity-60"
            >
              {twilioMutation.isPending ? 'Saving...' : account?.provider === 'twilio_whatsapp' ? 'Update Twilio' : 'Connect Twilio'}
            </button>
          </div>
        </div>
      )}

      {step === 'credentials' && (
        <div className="mt-2.5 space-y-2 text-xs">
          {account ? (
            <div className="rounded-md bg-emerald-50 p-2 text-emerald-700 dark:bg-emerald-950/40 dark:text-emerald-300">
              Connected phone ID {account.accountId}. Token {account.hasAccessToken ? 'stored' : 'missing'}.
            </div>
          ) : (
            <div className="rounded-md bg-amber-50 p-2 text-amber-700 dark:bg-amber-950/40 dark:text-amber-300">
              Save the Meta Cloud API credentials to activate WhatsApp for this clinic.
            </div>
          )}
          <WebhookRow url={webhookUrl} />
          <WhatsAppBookingReadiness />
          <WhatsAppOperatingStandards />

          <label className="block">
            <span className="mb-1 block font-medium text-gray-500 dark:text-gray-400">Phone number ID</span>
            <input
              value={accountId}
              onChange={(event) => setAccountId(event.target.value)}
              className="w-full rounded-md border border-gray-300 bg-white px-2 py-1.5 text-sm dark:border-gray-700 dark:bg-gray-950"
              placeholder="1234567890"
              required
            />
          </label>
          <label className="block">
            <span className="mb-1 block font-medium text-gray-500 dark:text-gray-400">Display name</span>
            <input
              value={displayName}
              onChange={(event) => setDisplayName(event.target.value)}
              className="w-full rounded-md border border-gray-300 bg-white px-2 py-1.5 text-sm dark:border-gray-700 dark:bg-gray-950"
              placeholder="Clinic WhatsApp"
            />
          </label>
          <label className="block">
            <span className="mb-1 block font-medium text-gray-500 dark:text-gray-400">
              Access token {account?.hasAccessToken ? '(leave blank to keep existing)' : ''}
            </span>
            <input
              value={accessToken}
              onChange={(event) => setAccessToken(event.target.value)}
              className="w-full rounded-md border border-gray-300 bg-white px-2 py-1.5 text-sm dark:border-gray-700 dark:bg-gray-950"
              placeholder="EAAB..."
              type="password"
              required={!account?.hasAccessToken}
            />
          </label>
          <label className="block">
            <span className="mb-1 block font-medium text-gray-500 dark:text-gray-400">Webhook verify token</span>
            <input
              value={webhookVerifyToken}
              onChange={(event) => setWebhookVerifyToken(event.target.value)}
              className="w-full rounded-md border border-gray-300 bg-white px-2 py-1.5 text-sm dark:border-gray-700 dark:bg-gray-950"
              placeholder={account?.hasWebhookVerifyToken ? 'Stored' : 'Create a random phrase and paste it in Meta'}
              type="password"
            />
          </label>
          <label className="block">
            <span className="mb-1 block font-medium text-gray-500 dark:text-gray-400">Token expires</span>
            <input
              value={tokenExpiresAt}
              onChange={(event) => setTokenExpiresAt(event.target.value)}
              className="w-full rounded-md border border-gray-300 bg-white px-2 py-1.5 text-sm dark:border-gray-700 dark:bg-gray-950"
              type="date"
            />
          </label>

          <div className="mt-3 flex items-center justify-between gap-2 border-t border-gray-100 pt-2 dark:border-gray-800">
            <button
              type="button"
              onClick={() => setStep('start')}
              className="rounded-md border border-gray-300 px-3 py-1.5 text-xs dark:border-gray-700"
            >
              Back
            </button>
            <p className={mutation.isError ? 'text-xs text-red-500' : 'text-xs text-emerald-500'}>{message}</p>
            <button
              type="submit"
              disabled={mutation.isPending}
              className="shrink-0 rounded-md bg-emerald-600 px-3 py-1.5 text-xs font-medium text-white disabled:opacity-60"
            >
              {mutation.isPending ? 'Saving...' : account ? 'Update' : 'Connect'}
            </button>
          </div>
        </div>
      )}
    </form>
  )
}
