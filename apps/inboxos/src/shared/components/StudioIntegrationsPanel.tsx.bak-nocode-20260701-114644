const DRIVE_FILE_TYPES = ['PDF', 'Docs', 'Sheets', 'Images']

function DriveIntegration({
  clinic,
  connected,
  drive,
}: {
  clinic: Clinic
  connected: boolean
  drive: GoogleDriveSettings
}) {
  const qc = useQueryClient()
  const settings = (clinic.settings ?? {}) as IntegrationSettings
  const [enabled, setEnabled] = useState(Boolean(drive.enabled))
  const [folderId, setFolderId] = useState(drive.folderId ?? '')
  const [folderName, setFolderName] = useState(drive.folderName ?? '')
  const [syncMode, setSyncMode] = useState<NonNullable<GoogleDriveSettings['syncMode']>>(drive.syncMode ?? 'knowledge_base')
  const [allowedFileTypes, setAllowedFileTypes] = useState<string[]>(drive.allowedFileTypes?.length ? drive.allowedFileTypes : ['PDF', 'Docs'])
  const [notes, setNotes] = useState(drive.notes ?? '')
  const [message, setMessage] = useState<string | null>(null)
  const hasFolder = folderId.trim().length > 0
  const status: IntegrationStatus = enabled ? (connected && hasFolder ? 'connected' : 'pending') : 'disconnected'

  function toggleFileType(type: string) {
    setAllowedFileTypes((current) =>
      current.includes(type) ? current.filter((item) => item !== type) : [...current, type],
    )
  }

  const save = useMutation({
    mutationFn: () =>
      api.patch(`/clinics/${clinic.id}`, {
        settings: {
          ...settings,
          googleDrive: {
            enabled,
            folderId: folderId.trim(),
            folderName: folderName.trim(),
            syncMode,
            allowedFileTypes,
            notes: notes.trim(),
          },
        },
      }),
    onSuccess: () => {
      setMessage('Google Drive settings saved.')
      qc.invalidateQueries({ queryKey: ['clinic', clinic.id] })
    },
    onError: (error) => setMessage(error instanceof Error ? error.message : 'Could not save Drive settings.'),
  })
  const disconnect = useMutation({
    mutationFn: () => {
      const nextSettings = { ...settings }
      delete nextSettings.googleDrive
      return api.patch(`/clinics/${clinic.id}`, { settings: nextSettings })
    },
    onSuccess: () => {
      setEnabled(false)
      setFolderId('')
      setFolderName('')
      setSyncMode('knowledge_base')
      setAllowedFileTypes(['PDF', 'Docs'])
      setNotes('')
      setMessage('Google Drive disconnected.')
      qc.invalidateQueries({ queryKey: ['clinic', clinic.id] })
    },
    onError: (error) => setMessage(error instanceof Error ? error.message : 'Could not disconnect Drive.'),
  })

  return (
    <IntegrationCard title="Google Drive" subtitle="Connect a clinic Drive folder for documents and KB sources." status={status} icon="googleDrive">
      <div className="space-y-3 text-xs">
        <div className="flex items-center justify-between gap-3">
          <span className="font-medium text-gray-700 dark:text-gray-200">Enable Drive folder</span>
          <Toggle on={enabled} onChange={setEnabled} label="Enable Google Drive folder" />
        </div>

        {!connected && (
          <div className="rounded-md border border-amber-300 bg-amber-50 p-2 text-[11px] text-amber-800 dark:border-amber-900 dark:bg-amber-950/30 dark:text-amber-200">
            Connect Google first so Docmee has OAuth access for Drive.
          </div>
        )}

        <div className="rounded-lg border border-sky-200/70 bg-sky-50/70 p-3 dark:border-sky-500/30 dark:bg-sky-500/10">
          <p className="text-sm font-semibold text-sky-900 dark:text-sky-100">Drive folder configuration</p>
          <p className="mt-1 text-[11px] text-sky-700 dark:text-sky-200">
            Paste the folder ID from Google Drive. This is the long value after /folders/ in the folder URL.
          </p>
        </div>

        <div className="grid gap-2 sm:grid-cols-2">
          <label className="block">
            <span className="mb-1 block font-medium text-gray-500 dark:text-gray-400">Folder ID</span>
            <input value={folderId} onChange={(event) => setFolderId(event.target.value)} className={field} placeholder="1AbCDriveFolderId..." />
          </label>
          <label className="block">
            <span className="mb-1 block font-medium text-gray-500 dark:text-gray-400">Folder name</span>
            <input value={folderName} onChange={(event) => setFolderName(event.target.value)} className={field} placeholder="Docmee Clinic Documents" />
          </label>
        </div>

        <div>
          <span className="mb-2 block font-medium text-gray-500 dark:text-gray-400">Use this folder for</span>
          <div className="grid gap-2">
            {DRIVE_SYNC_MODES.map((mode) => {
              const active = syncMode === mode.value
              return (
                <button
                  key={mode.value}
                  type="button"
                  onClick={() => setSyncMode(mode.value)}
                  className={`rounded-lg border px-3 py-2 text-left transition ${
                    active
                      ? 'border-sky-400 bg-sky-600 text-white'
                      : 'border-gray-200 bg-transparent text-gray-600 hover:border-sky-300 hover:bg-sky-500/5 dark:border-gray-800 dark:text-gray-300'
                  }`}
                >
                  <span className="block text-sm font-semibold">{mode.label}</span>
                  <span className={`mt-1 block text-[11px] ${active ? 'text-sky-100' : 'text-gray-500 dark:text-gray-400'}`}>{mode.description}</span>
                </button>
              )
            })}
          </div>
        </div>

        <div>
          <span className="mb-2 block font-medium text-gray-500 dark:text-gray-400">Allowed file types</span>
          <div className="flex flex-wrap gap-2">
            {DRIVE_FILE_TYPES.map((type) => {
              const active = allowedFileTypes.includes(type)
              return (
                <button
                  key={type}
                  type="button"
                  onClick={() => toggleFileType(type)}
                  className={`rounded-full border px-3 py-1 text-[11px] font-semibold ${
                    active
                      ? 'border-sky-400 bg-sky-600 text-white'
                      : 'border-gray-300 text-gray-500 hover:bg-gray-50 dark:border-gray-700 dark:text-gray-300 dark:hover:bg-gray-800'
                  }`}
                >
                  {type}
                </button>
              )
            })}
          </div>
        </div>

        <label className="block">
          <span className="mb-1 block font-medium text-gray-500 dark:text-gray-400">Notes</span>
          <input value={notes} onChange={(event) => setNotes(event.target.value)} className={field} placeholder="Owner, folder policy, or sync notes" />
        </label>

        <div className="flex flex-wrap items-center justify-between gap-2 pt-1">
          <p className={save.isError || disconnect.isError ? 'text-xs text-red-500' : 'text-xs text-emerald-500'}>{message}</p>
          <div className="flex flex-wrap gap-2">
            <button type="button" onClick={() => disconnect.mutate()} disabled={disconnect.isPending || (!enabled && !folderId.trim())} className="rounded-md border border-red-300 px-3 py-1.5 text-xs font-medium text-red-600 disabled:opacity-50 dark:border-red-900 dark:text-red-300">
              {disconnect.isPending ? 'Disconnecting...' : 'Disconnect'}
            </button>
            <button type="button" onClick={() => save.mutate()} disabled={save.isPending} className="rounded-md bg-emerald-600 px-3 py-1.5 text-xs font-medium text-white disabled:opacity-60">
              {save.isPending ? 'Saving...' : 'Save'}
            </button>
          </div>
        </div>
      </div>
    </IntegrationCard>
  )
}

