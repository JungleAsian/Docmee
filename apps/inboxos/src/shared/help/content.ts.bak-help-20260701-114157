// Docmee Help Center — self-contained bilingual (ES/EN) knowledge base.
//
// Mirrors the BotPenguin help-center information architecture: a searchable
// landing page → categories → articles, where each article is a sequence of
// structured blocks (no markdown library, no dangerouslySetInnerHTML — the
// renderer maps blocks to safe React elements). All copy lives here so the
// feature never needs to touch the typed panel dictionary in `i18n.ts`.
import type { PanelLanguage } from '../types'

/** A string available in every panel language. */
export type Localized = Record<PanelLanguage, string>

/** Pick the active language with a sensible fallback chain. */
export function L(value: Localized, lang: PanelLanguage): string {
  return value[lang] ?? value.en ?? value.es
}

/** Article body blocks — a tiny, safe content model rendered by the article page. */
export type HelpBlock =
  | { type: 'h'; text: Localized }
  | { type: 'p'; text: Localized }
  | { type: 'ul'; items: Localized[] }
  | { type: 'steps'; items: Localized[] }
  | { type: 'note'; text: Localized }
  | { type: 'video'; title: Localized; src: Localized; caption?: Localized }

export interface HelpArticle {
  slug: string
  title: Localized
  excerpt: Localized
  body: HelpBlock[]
}

export interface HelpCategory {
  slug: string
  icon: string // NavIcon glyph name
  title: Localized
  description: Localized
  articles: HelpArticle[]
}

