    outlook: {
      eyebrow: 'Best for Microsoft 365',
      description: 'Docmee will use Outlook SMTP with the Microsoft 365 server settings.',
      bestFor: 'Clinics using Outlook, Exchange, or 365',
    },
    other: {
      eyebrow: 'Bring your own provider',
      description: 'Use this when your provider gives you a custom SMTP host and port.',
      bestFor: 'Private domains, hosting mailboxes, or SMTP services',
    },
  }
  const setupChecks = [
    { label: 'Choose the clinic mailbox', done: Boolean(provider), help: providerGuidance[provider].bestFor },
    { label: 'Add sender email', done: hasSender, help: hasSender ? fromEmail.trim() : 'Use the address patients and staff should see.' },
    { label: 'Add mailbox login', done: smtpUser.trim().length > 0, help: smtpUser.trim() || activeDefaults.userHelp },
    { label: 'Add app password', done: smtpPasswordSet || smtpPassword.trim().length > 0, help: smtpPasswordSet && !smtpPassword ? 'Password is saved securely.' : activeDefaults.passwordHelp },
    { label: 'Confirm delivery with a test', done: Boolean(config.lastTestAt), help: config.lastTestAt ? `Last tested ${new Date(config.lastTestAt).toLocaleDateString()}` : 'Save first, then send a test email.' },
  ]

  function chooseProvider(next: EmailProvider) {
    const defaults = EMAIL_PROVIDER_DEFAULTS[next]
    setProvider(next)
    if (next !== 'other') {
      setSmtpHost(defaults.host)
      setSmtpPort(String(defaults.port))
      setSmtpSecure(defaults.secure)
    } else if (!smtpHost.trim()) {
      setSmtpPort(String(defaults.port))
      setSmtpSecure(defaults.secure)
    }
