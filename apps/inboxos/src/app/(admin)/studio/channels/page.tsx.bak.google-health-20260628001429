export default function ChannelsPage() {
  const { t } = useI18n()
  const { clinicId, switchClinic } = useActiveClinic()
  const queryClient = useQueryClient()

  const query = useQuery({
    queryKey: ['clinic', clinicId],
    enabled: Boolean(clinicId),
    queryFn: () => api.get<{ clinic: Clinic }>(`/clinics/${clinicId}`),
  })
  const clinic = query.data?.clinic
  const channelQuery = useQuery({
    queryKey: ['clinic-channels', clinicId],
    enabled: Boolean(clinicId),
    queryFn: () => api.get<{ accounts: ChannelAccount[] }>(`/clinics/${clinicId}/channels`),
  })
  const whatsappAccounts = channelQuery.data?.accounts.filter((account) => account.channel === 'whatsapp') ?? []
  const whatsappAccount =
    whatsappAccounts.find((account) => account.provider === 'evolution_test') ??
    whatsappAccounts.find((account) => account.status === 'active') ??
    whatsappAccounts[0] ??
    null

  // Date.now() is read once per render; channelStatus stays pure (now is passed in).
  const cards = useMemo<ServiceCard[]>(
    () =>
      clinic
        ? channelCards(clinic, { apiBase: API_BASE, now: Date.now() }).filter(
            (card) => card.key === 'messenger' || card.key === 'instagram',
          )
        : [],
    [clinic],
  )
  const connectedCount = cards.filter((c) => c.status === 'connected').length

  return (
    <div className="mx-auto max-w-4xl p-6">
      <div className="mb-1 flex flex-wrap items-center justify-between gap-3">
        <h1 className="text-xl font-bold">{t('studio.channels.title')}</h1>
        <ClinicSelect value={clinicId} onChange={switchClinic} label={t('studio.usage.selectClinic')} />
      </div>
      <p className="mb-4 text-xs text-gray-400">{t('studio.channels.subtitle')}</p>

      {!clinicId ? (
        <p className="text-sm text-gray-400">{t('studio.kb.selectClinic')}</p>
      ) : query.isLoading ? (
        <div className="grid grid-cols-1 gap-3 sm:grid-cols-2">
          {[0, 1, 2, 3].map((i) => (
            <div
              key={i}
              className="h-32 animate-pulse rounded-lg border border-gray-200 bg-gray-50 dark:border-gray-800 dark:bg-gray-900"
            />
          ))}
        </div>
      ) : query.isError || !clinic ? (
        <div className="rounded-lg border border-red-200 bg-red-50 p-4 text-sm text-red-700 dark:border-red-900 dark:bg-red-950 dark:text-red-300">
          {t('common.error')}{' '}
          <button type="button" onClick={() => query.refetch()} className="font-medium underline">
            {t('common.retry')}
          </button>
        </div>
      ) : (
        <>
          <div className="mb-3 flex items-center gap-2 text-xs text-gray-500">
            <span className="rounded-full bg-gray-100 px-2 py-0.5 font-medium dark:bg-gray-800">
              {t('studio.channels.connectedSummary', { n: connectedCount, total: cards.length })}
            </span>
          </div>

          <ProviderStatusPanel clinic={clinic} whatsappAccounts={whatsappAccounts} />
          <ClinicLaunchReadinessPanel clinic={clinic} clinicId={clinicId} whatsappAccounts={whatsappAccounts} channelCards={cards} />

          <div className="grid grid-cols-1 gap-3 sm:grid-cols-2">
            {cards.map((card) => (
              <ServiceCardView key={card.key} card={card} clinic={clinic} onSaved={() => queryClient.invalidateQueries({ queryKey: ['clinic', clinicId] })} />
            ))}
            <WhatsAppCard clinicId={clinicId} account={whatsappAccount} webhookUrl={`${API_BASE}/webhook/whatsapp`} onSaved={() => queryClient.invalidateQueries({ queryKey: ['clinic-channels', clinicId] })} />
          </div>
        </>
      )}
    </div>
  )
}

function ProviderStatusPanel({
  clinic,
  whatsappAccounts,
}: {
  clinic: Clinic
  whatsappAccounts: ChannelAccount[]
}) {
  const { t } = useI18n()
  const settings = clinic.settings as ClinicSettings
  const whatsappActive = whatsappAccounts.some((account) => account.status === 'active')
  const whatsappError = whatsappAccounts.some((account) => account.status === 'error')
  const whatsappConfigured = whatsappAccounts.some(
    (account) =>
      account.provider === 'twilio_whatsapp'
        ? Boolean(account.twilioMessagingServiceSid || account.twilioWhatsappFrom || account.twilioSenderSid)
        : account.hasAccessToken || account.provider === 'evolution_test',
  )
  const lastWhatsAppUpdate = whatsappAccounts
    .map((account) => account.updatedAt)
    .sort()
    .at(-1)

  const googleConnected = Boolean(settings.googleCalendar && typeof settings.googleCalendar === 'object')
  const sheetsReady = Boolean(settings.googleSheets?.enabled && settings.googleSheets?.spreadsheetId)
  const providerQuery = useQuery({
    queryKey: ['provider-status'],
    queryFn: () => api.get<ProviderStatusResponse>('/provider-status'),
  })
  const providerMap = new Map((providerQuery.data?.providers ?? []).map((provider) => [provider.key, provider]))
  const email = providerMap.get('email')
  const openai = providerMap.get('openai')
  const anthropic = providerMap.get('anthropic')
  const llmMissing = [...(openai?.missing ?? []), ...(anthropic?.missing ?? [])]
  const llmFallback = openai?.state === 'fallback' || anthropic?.state === 'fallback'
  const llmReady = Boolean(openai?.configured || anthropic?.configured)
  const requiredMissing = providerQuery.data?.summary?.requiredMissing ?? []
  const checkedAt = providerQuery.data?.checkedAt ? new Date(providerQuery.data.checkedAt).toLocaleString() : null

  return (
    <section className="mb-3 rounded-lg border border-gray-200 bg-white p-3 dark:border-gray-800 dark:bg-gray-900">
      <div className="mb-2 flex flex-wrap items-center justify-between gap-2">
        <h2 className="text-sm font-semibold">{t('studio.channels.providerStatus.title')}</h2>
        <span className="text-[11px] text-gray-400">{checkedAt ? `Checked ${checkedAt}` : t('studio.channels.providerStatus.noSecrets')}</span>
      </div>
      {providerQuery.data?.overall && providerQuery.data.overall !== 'ready' ? (
        <div className="mb-2 rounded-md border border-amber-200 bg-amber-50 px-2 py-1.5 text-[11px] text-amber-900 dark:border-amber-900 dark:bg-amber-950/40 dark:text-amber-200">
          {requiredMissing.length > 0
            ? `Required production providers missing: ${requiredMissing.join(', ')}.`
            : 'LLM production key is still missing; keep test fallback disabled before launch.'}
        </div>
      ) : null}
      <div className="grid gap-2 sm:grid-cols-2 lg:grid-cols-4">
        <ProviderTile
          label={t('studio.channels.providerStatus.whatsapp')}
          state={whatsappError ? 'error' : whatsappActive && whatsappConfigured ? 'ready' : whatsappConfigured ? 'warning' : 'missing'}
          detail={
            whatsappError
              ? t('studio.channels.providerStatus.whatsappError')
              : lastWhatsAppUpdate
              ? t('studio.channels.providerStatus.lastUpdated', { date: lastWhatsAppUpdate.slice(0, 10) })
              : t('studio.channels.providerStatus.noWebhookYet')
          }
        />
        <ProviderTile
          label={t('studio.channels.providerStatus.google')}
          state={googleConnected ? 'ready' : 'missing'}
          detail={googleConnected ? t('studio.channels.providerStatus.calendarReady') : t('studio.channels.providerStatus.connectGoogle')}
        />
        <ProviderTile
          label={t('studio.channels.providerStatus.email')}
          state={email?.configured ? 'ready' : 'missing'}
          detail={
            email?.configured
              ? t('studio.channels.providerStatus.emailReady')
              : t('studio.channels.providerStatus.missingVars', { vars: (email?.missing ?? ['RESEND_API_KEY']).join(', ') })
          }
        />
        <ProviderTile
          label={t('studio.channels.providerStatus.llm')}
          state={llmFallback ? 'fallback' : llmReady ? 'ready' : 'missing'}
          detail={
            llmFallback
              ? t('studio.channels.providerStatus.llmFallback')
              : llmReady
                ? t('studio.channels.providerStatus.llmReady')
                : t('studio.channels.providerStatus.missingVars', { vars: llmMissing.join(', ') || 'OPENAI_API_KEY, ANTHROPIC_API_KEY' })
          }
        />
        <ProviderTile
          label={t('studio.channels.providerStatus.sheets')}
          state={sheetsReady ? 'ready' : 'missing'}
          detail={sheetsReady ? t('studio.channels.providerStatus.sheetsReady') : t('studio.channels.providerStatus.configureSheets')}
        />
      </div>
    </section>
  )
}

function ClinicLaunchReadinessPanel({
  clinic,
  clinicId,
  whatsappAccounts,
  channelCards,
}: {
  clinic: Clinic
  clinicId: string
  whatsappAccounts: ChannelAccount[]
  channelCards: ServiceCard[]
}) {
  const settings = clinic.settings as ClinicSettings
  const settingsRecord = settings as unknown as Record<string, unknown>
  const clinicRecord = clinic as unknown as Record<string, unknown>
  const clinicName =
    typeof clinicRecord.name === 'string'
      ? clinicRecord.name
      : typeof clinicRecord.id === 'string'
        ? clinicRecord.id
        : 'Selected clinic'
  const waiverStorageKey = `docmee-launch-waivers:${clinicId}`
  const [waivers, setWaivers] = useState<Record<string, LaunchWaiver>>(() => {
    if (typeof window === 'undefined') return {}
    try {
      return JSON.parse(window.localStorage.getItem(waiverStorageKey) ?? '{}') as Record<string, LaunchWaiver>
    } catch {
      return {}
    }
  })
  useEffect(() => {
    if (typeof window === 'undefined') return
    try {
      setWaivers(JSON.parse(window.localStorage.getItem(waiverStorageKey) ?? '{}') as Record<string, LaunchWaiver>)
    } catch {
      setWaivers({})
    }
  }, [waiverStorageKey])
  const readinessQuery = useQuery({
    queryKey: ['launch-readiness', clinicId],
    enabled: Boolean(clinicId),
    queryFn: () =>
      api.get<{
        readiness: { waivers: Record<string, LaunchWaiver>; whatsappTests: Record<string, string>; updatedAt: string }
        persistence?: 'database' | 'file'
      }>(`/clinics/${clinicId}/launch-readiness`),
  })
  const readinessEventsQuery = useQuery({
    queryKey: ['launch-readiness-events', clinicId],
    enabled: Boolean(clinicId),
    queryFn: () =>
      api.get<{
        events: LaunchReadinessEvent[]
        persistence?: 'database' | 'file'
      }>(`/clinics/${clinicId}/launch-readiness/events`),
  })
  const readinessMutation = useMutation({
    mutationFn: (nextWaivers: Record<string, LaunchWaiver>) =>
      api.put(`/clinics/${clinicId}/launch-readiness`, { waivers: nextWaivers }),
    onSuccess: () => readinessEventsQuery.refetch(),
  })
  const activeWaivers = { ...waivers, ...(readinessQuery.data?.readiness.waivers ?? {}) }
  const [copied, setCopied] = useState(false)
  const whatsappActive = whatsappAccounts.some((account) => account.status === 'active')
  const whatsappError = whatsappAccounts.some((account) => account.status === 'error')
  const whatsappConfigured = whatsappAccounts.some(
    (account) =>
      account.provider === 'twilio_whatsapp'
        ? Boolean(account.twilioMessagingServiceSid || account.twilioWhatsappFrom || account.twilioSenderSid)
        : account.hasAccessToken || account.provider === 'evolution_test',
  )
  const googleConnected = Boolean(settings.googleCalendar && typeof settings.googleCalendar === 'object')
  const sheetsReady = Boolean(settings.googleSheets?.enabled && settings.googleSheets?.spreadsheetId)
  const socialChannelsReady = channelCards.some((card) => card.status === 'connected')
  const businessHoursReady = Boolean(
    settingsRecord.businessHours ||
      settingsRecord.hours ||
      settingsRecord.workingHours ||
      clinicRecord.businessHours ||
      clinicRecord.hours,
  )
  const aiInstructionsReady = Boolean(
    settingsRecord.aiInstructions ||
      settingsRecord.systemPrompt ||
      settingsRecord.instructions ||
      settingsRecord.persona ||
      settingsRecord.guardrails,
  )
  const ownerReady = Boolean(
    settingsRecord.owner ||
      settingsRecord.admin ||
      settingsRecord.users ||
      clinicRecord.ownerId ||
      clinicRecord.adminId,
  )
  const providerQuery = useQuery({
    queryKey: ['provider-status'],
    queryFn: () => api.get<ProviderStatusResponse>('/provider-status'),
  })
  const providerMap = new Map((providerQuery.data?.providers ?? []).map((provider) => [provider.key, provider]))
  const emailReady = providerMap.get('email')?.configured
  const llmReady = Boolean(providerMap.get('openai')?.configured || providerMap.get('anthropic')?.configured)
  const checks = [
    {
      key: 'whatsapp',
      area: 'WhatsApp provider',
      owner: 'Implementation',
      severity: 'Required',
      state: whatsappError ? 'fail' : whatsappActive && whatsappConfigured ? 'pass' : 'fail',
      detail: whatsappError ? 'Provider is in error state.' : whatsappConfigured ? 'Provider credentials exist.' : 'Provider not fully configured.',
      action: 'Open Channels and finish Meta, Twilio, or test-mode setup.',
      href: '#whatsapp',
    },
    {
      key: 'calendar',
      area: 'Calendar booking',
      owner: 'Clinic operations',
      severity: 'Required',
      state: googleConnected ? 'pass' : 'fail',
      detail: googleConnected ? 'Google Calendar settings are present.' : 'Calendar connection is missing.',
      action: 'Connect Google Calendar before enabling automated appointment booking.',
      href: '/studio/doctors',
    },
    {
      key: 'availability',
      area: 'Doctors and availability',
      owner: 'Clinic operations',
      severity: 'Required',
      state: businessHoursReady ? 'pass' : 'warning',
      detail: businessHoursReady ? 'Business hours or working-hours config is present.' : 'Hours need confirmation against staff schedules.',
      action: 'Review doctors, services, and weekly availability.',
      href: '/studio/doctors',
    },
    {
      key: 'ai-instructions',
      area: 'AI instructions',
      owner: 'Clinical admin',
      severity: 'Required',
      state: aiInstructionsReady ? 'pass' : 'warning',
      detail: aiInstructionsReady ? 'Instruction or guardrail settings are present.' : 'No prompt/guardrail signal found in clinic settings.',
      action: 'Confirm clinical boundaries, escalation rules, and prohibited advice.',
      href: '/studio/kb',
    },
    {
      key: 'knowledge',
      area: 'Knowledge sources',
      owner: 'Clinical admin',
      severity: 'Recommended',
      state: 'warning',
      detail: 'Review freshness and relevance before trusting AI answers.',
      action: 'Open Knowledge Base and re-index stale or irrelevant sources.',
      href: '/studio/kb',
    },
    {
      key: 'templates',
      area: 'Message templates',
      owner: 'Implementation',
      severity: 'Recommended',
      state: 'warning',
      detail: 'Template approval cannot be inferred from Channels.',
      action: 'Confirm reminders, confirmations, cancellations, and follow-up templates.',
      href: '/studio/templates',
    },
    {
      key: 'quick-replies',
      area: 'Quick replies',
      owner: 'Support',
      severity: 'Recommended',
      state: 'warning',
      detail: 'Support shortcuts should match clinic services and escalation policy.',
      action: 'Seed clinic info, booking, handoff, and safety replies.',
      href: '/studio/quick-replies',
    },
    {
      key: 'social-channels',
      area: 'Messenger and Instagram',
      owner: 'Implementation',
      severity: 'Optional',
      state: socialChannelsReady ? 'pass' : 'warning',
      detail: socialChannelsReady ? 'At least one social messaging channel is connected.' : 'No secondary social channel is connected.',
      action: 'Enable only when the clinic actively handles Facebook or Instagram patient messages.',
      href: '#provider-status',
    },
    {
      key: 'provider-env',
      area: 'Provider environment',
      owner: 'Engineering',
      severity: 'Required',
      state: providerQuery.isError ? 'warning' : emailReady && llmReady ? 'pass' : 'fail',
      detail: providerQuery.isError ? 'Provider status endpoint is unavailable.' : emailReady && llmReady ? 'Email and LLM providers are configured.' : 'Email or LLM provider is missing.',
      action: 'Review server env vars before launch.',
      href: '#provider-status',
    },
    {
      key: 'crm-export',
      area: 'CRM export',
      owner: 'Operations',
      severity: 'Optional',
      state: sheetsReady ? 'pass' : 'warning',
      detail: sheetsReady ? 'Google Sheets export target is configured.' : 'Sheets export is not configured.',
      action: 'Configure Sheets only when the clinic needs spreadsheet CRM export.',
      href: '#provider-status',
    },
    {
      key: 'operator-owner',
      area: 'Operator ownership',
      owner: 'Account admin',
      severity: 'Required',
      state: ownerReady ? 'pass' : 'warning',
      detail: ownerReady ? 'Owner/admin signal is present.' : 'Confirm who can approve launch and waivers.',
      action: 'Assign launch reviewer and support escalation owner.',
      href: '/studio/users',
    },
  ] as const
  const requiredChecks = checks.filter((check) => check.severity === 'Required')
  const failingRequired = requiredChecks.filter((check) => check.state !== 'pass' && !activeWaivers[check.key])
  const passCount = checks.filter((check) => check.state === 'pass').length
  const waivedCount = requiredChecks.filter((check) => check.state !== 'pass' && activeWaivers[check.key]).length
  const summary = checks
    .map((check) => {
      const waiver = activeWaivers[check.key]
      const status = check.state === 'pass' ? 'PASS' : waiver ? 'WAIVED' : check.state.toUpperCase()
      return `${check.severity} | ${status} | ${check.area} | ${check.action}${waiver ? ` | waiver: ${waiver.reason}` : ''}`
    })
    .join('\n')

  function saveWaiver(key: string, waiver: LaunchWaiver | null) {
    const next = { ...activeWaivers }
    if (waiver) next[key] = waiver
    else delete next[key]
    setWaivers(next)
    if (typeof window !== 'undefined') {
      window.localStorage.setItem(waiverStorageKey, JSON.stringify(next))
    }
    readinessMutation.mutate(next)
  }

  async function copyAudit() {
    try {
      await navigator.clipboard.writeText(`Docmee launch readiness audit\nClinic: ${clinicName}\n\n${summary}`)
      setCopied(true)
      window.setTimeout(() => setCopied(false), 1600)
    } catch {
      setCopied(false)
    }
  }

  return (
    <section className="mb-3 rounded-lg border border-gray-200 bg-white p-3 dark:border-gray-800 dark:bg-gray-900">
      <div className="flex flex-wrap items-start justify-between gap-3">
        <div>
          <h2 className="text-sm font-semibold">Clinic launch readiness</h2>
          <p className="mt-0.5 text-xs text-gray-500 dark:text-gray-400">
            {passCount}/{checks.length} checks passing. {waivedCount} required waiver(s) recorded.
          </p>
          <p className="mt-0.5 text-[11px] text-gray-400">
            Evidence persistence: {readinessQuery.data?.persistence === 'database' ? 'database audit table' : 'local fallback'}
