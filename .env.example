# Copy to .env for local development. Do not put live credentials in this file.
# Test mode uses local Docker PostgreSQL/Redis and explicitly disables provider calls.
NODE_ENV=development
API_PORT=3001
API_HOST=0.0.0.0
PORT=3000
APP_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001

# Local infrastructure (docker compose up -d postgres redis)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/docmee
REDIS_URL=redis://localhost:6379
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=replace-with-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key

# Generate distinct local-only values. Never reuse these in any shared environment.
JWT_SECRET=replace-with-a-long-local-access-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-local-refresh-secret
ENCRYPTION_KEY=replace-with-a-32-byte-base64-key

# Reproducible local test mode. Set false only with explicitly configured providers.
LLM_STUB=true
DOCMEE_BUILD_ID=local-dev

# Optional delivery providers. Leave blank to disable each integration locally.
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v24.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
DEEPGRAM_API_KEY=

# Optional storage, push, knowledge-base, and runtime controls.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:dev@example.test
DOCMEE_RUNTIME_DATA_DIR=.runtime-data
DOCMEE_KB_GIT_REPO=
DOCMEE_KB_WEBHOOK_SECRET=
DOCMEE_KB_DEPLOY_KEY_PATH=
FOLLOWUP_MAX_PER_PATIENT_PER_DAY=3
